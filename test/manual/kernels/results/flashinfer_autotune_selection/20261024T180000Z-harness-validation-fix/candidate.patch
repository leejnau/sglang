+@pytest.mark.parametrize("inference_output", [False, True])
+@pytest.mark.parametrize(
+    "kind",
+    [
+        "read_alias",
+        "partial_read_alias",
+        "scratch_alias",
+        "integer",
+        "wrong_role",
+        "strided_output",
+    ],
+)
+def test_fp8_validation_rejects_unsafe_roles(inference_output, kind):
+    module = _harness()
+    with torch.inference_mode(inference_output):
+        output = torch.ones(
+            4, dtype=torch.int64 if kind == "integer" else torch.float32
+        )
+        if kind == "strided_output":
+            output = torch.ones(8)[::2]
+        inputs = [
+            torch.ones(4),
+            torch.ones(4),
+            torch.ones(1),
+            torch.ones(1),
+            output,
+            torch.empty(8, dtype=torch.uint8),
+        ]
+        if kind == "read_alias":
+            inputs[0] = output
+        elif kind == "partial_read_alias":
+            storage = torch.ones(8)
+            output = inputs[4] = storage[:4]
+            inputs[0] = storage[2:6]
+        elif kind == "scratch_alias":
+            inputs[5] = output
+        elif kind == "wrong_role":
+            inputs[4] = torch.ones_like(output)
+    tensors = [output, *inputs]
+    before = [tensor.clone() for tensor in tensors]
+    with pytest.raises(ValueError):
+        module.prepare_fp8_validation(output, inputs)
+    assert all(torch.equal(a, b) for a, b in zip(before, tensors, strict=True))
+    assert not torch.is_inference_mode_enabled()
+
