+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+@pytest.mark.parametrize("inference_output", [False, True])
+@pytest.mark.parametrize("kind", ["correct", "wrong", "no_write"])
+@pytest.mark.parametrize("refresh", [False, True])
+def test_graph_study_validates_owned_output(
+    monkeypatch, inference_output, kind, refresh
+):
+    from flashinfer.autotuner import TunableRunner
+
+    module = _harness()
+    original = AutoTuner._instance
+    with torch.inference_mode(inference_output):
+        output = torch.empty(4, device="cuda")
+        unrelated = torch.empty_like(output)
+        inputs = [
+            torch.ones_like(output),
+            torch.ones_like(output),
+            torch.ones(1, device="cuda"),
+            torch.ones(1, device="cuda"),
+            output,
+            torch.empty(8, dtype=torch.uint8, device="cuda"),
+        ]
+    assert output.is_inference() == inference_output
+    profiles, refreshes = [], []
+    sampled = False
+    sample = module.interleaved_graph_samples
+
+    class Runner(TunableRunner):
+        def get_valid_tactics(self, inputs, profile):
+            return [0]
+
+        def forward(self, inputs, tactic=-1, **kwargs):
+            with torch.inference_mode():
+                if tactic == -1 or kind == "correct":
+                    torch.add(inputs[0], 1, out=output)
+                elif kind == "wrong":
+                    torch.add(inputs[0], 2, out=output)
+                else:
+                    torch.add(inputs[1], 1, out=unrelated)
+            return output
+
+    def profile(self, runner, inputs, tactic, config, **kwargs):
+        profiles.append(tactic)
+        return 1.0 if tactic == 0 else 2.0
+
+    def samples(*args, **kwargs):
+        nonlocal sampled
+        result = sample(*args, **kwargs)
+        sampled = True
+        return result
+
+    def prepare(actual, actual_inputs):
+        assert sampled and not torch.cuda.is_current_stream_capturing()
+        assert not torch.is_inference_mode_enabled()
+        assert actual is output and actual_inputs is inputs
+        refreshes.append(actual.data_ptr())
+        module.prepare_fp8_validation(actual, actual_inputs)
+
+    monkeypatch.setattr(AutoTuner, "_profile_single_kernel", profile)
+    monkeypatch.setattr(module, "interleaved_graph_samples", samples)
+    kwargs = {"prepare_validation": prepare} if refresh else {}
+
+    def study():
+        return module.graph_selection_study(
+            "test.owned_output",
+            [Runner()],
+            TuningConfig(),
+            inputs,
+            {},
+            _study_args(),
+            **kwargs,
+        )
+
+    accepted = kind == "correct" or (kind == "no_write" and not refresh)
+    if accepted:
+        report = study()
+        row = report["trials"][0]
+        assert row["cache_hit"] and row["tactic"] == "0"
+        assert report["validation"]["output_refresh"] == (
+            "fixture_callback" if refresh else "unavailable"
+        )
+    else:
+        with pytest.raises(AssertionError):
+            study()
+    assert profiles == [-1, 0]
+    assert len(refreshes) == ((3 if accepted else 2) if refresh else 0)
+    assert AutoTuner._instance is original
+    assert not torch.is_inference_mode_enabled()
+
