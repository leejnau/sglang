+@pytest.mark.parametrize("inference_output", [False, True])
+def test_fp8_validation_refresh_preserves_views(inference_output):
+    module = _harness()
+    with torch.inference_mode(inference_output):
+        declared = torch.ones(1, 2, 2)
+        output = declared.view(2, 2)
+        inputs = [
+            torch.ones(4),
+            torch.ones(4),
+            torch.ones(1),
+            torch.ones(1),
+            declared,
+            torch.empty(8, dtype=torch.uint8),
+        ]
+    reads = [tensor.clone() for tensor in inputs[:4]]
+    pointer = output.data_ptr()
+    module.prepare_fp8_validation(output, inputs)
+    assert torch.isnan(output).all()
+    assert output.data_ptr() == declared.data_ptr() == pointer
+    assert output.is_inference() == inference_output
+    assert all(torch.equal(a, b) for a, b in zip(reads, inputs[:4], strict=True))
+    assert not torch.is_inference_mode_enabled()
+
