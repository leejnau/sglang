+def prepare_fp8_validation(output, inputs):
+    """Refresh declared FP8 read0..3/output4/scratch5 roles outside timing."""
+    if len(inputs) != 6 or not all(
+        isinstance(t, torch.Tensor) for t in [output, *inputs]
+    ):
+        raise ValueError("FP8 validation requires six tensors and one tensor output")
+    declared = inputs[4]
+    if (
+        not output.is_floating_point()
+        or output.dtype != declared.dtype
+        or output.device != declared.device
+        or not output.is_contiguous()
+        or not declared.is_contiguous()
+        or output.data_ptr() != declared.data_ptr()
+        or output.numel() != declared.numel()
+    ):
+        raise ValueError("FP8 validation requires the declared floating output buffer")
+    begin, size = output.untyped_storage().data_ptr(), output.untyped_storage().nbytes()
+    for tensor in [*inputs[:4], inputs[5]]:
+        other, length = (
+            tensor.untyped_storage().data_ptr(),
+            tensor.untyped_storage().nbytes(),
+        )
+        if begin < other + length and other < begin + size:
+            raise ValueError(
+                "FP8 output refresh would alias a read operand or workspace"
+            )
+    with torch.inference_mode():
+        output.fill_(float("nan"))


